# Fortexa Configuration
# Copy this file to backend/.env for local Python runs.
# Docker Compose reads SECRET_KEY from your shell or project-root .env.

APP_NAME=Fortexa
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-fortexa
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: PostgreSQL or SQLite
# PostgreSQL: postgresql://user:password@localhost:5432/fortexa
# SQLite (default): sqlite:///./fortexa.db
DATABASE_URL=sqlite:///./fortexa.db

UPLOAD_DIR=./uploads
RUNS_DIR=./runs/general-ai-trained-indoor-20261005
DETECTOR_TASK=ai-image

# Redis (optional - for Celery async processing)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

MAX_UPLOAD_MB=200
RETENTION_HOURS=24
MAX_VIDEO_SECONDS=300
MAX_IMAGE_PIXELS=20000000
FRONTEND_ORIGIN=http://localhost:5173

# Google OAuth (optional - leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback

# Admin seed credentials
ADMIN_EMAIL=admin@fortexa.app
ADMIN_PASSWORD=
